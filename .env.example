# ==============================================================================
# THE LUMINARIES — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   cp .env.example .env
#
# All variables below are read by the application core, dispatcher, and ops tooling.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dispatcher & Task Stream File Paths (app.py)
# ------------------------------------------------------------------------------
# Path to the append-only tasks stream ledger
SOLARIS_TASKS_FILE=dispatcher/tasks.jsonl

# Path to active tasks tracking state
SOLARIS_ACTIVE_TASKS_FILE=dispatcher/active_tasks.json

# Path to resolved task overrides and suppression records
SOLARIS_RESOLVED_FILE=dispatcher/resolved.json

# ------------------------------------------------------------------------------
# 2. Watchdog & Task Timeout Thresholds (app.py)
# ------------------------------------------------------------------------------
# Timeout (in seconds) before a QUEUED task without progress is flagged as stuck (default: 600)
SOLARIS_STUCK_QUEUED_THRESHOLD_SEC=600

# Timeout (in seconds) before a RUNNING task without updates is flagged as stuck (default: 3600)
SOLARIS_STUCK_RUNNING_THRESHOLD_SEC=3600

# Optional: Global override threshold (in seconds) applied to both queued and running tasks
# SOLARIS_STUCK_THRESHOLD_SEC=1800

# ------------------------------------------------------------------------------
# 3. Operations & Telemetry Directory Paths (ops/generate_telemetry.py)
# ------------------------------------------------------------------------------
# Root directory of the Solaris installation (default: auto-detected repository root)
SOLARIS_BASE_DIR=/srv/solaris

# Output destination for aggregated daily telemetry metrics
SOLARIS_TELEMETRY_OUT=/srv/solaris/telemetry_today.json

# Path to knowledge storage vault for telemetry aggregation
SOLARIS_VAULT_DIR=/srv/solaris/vault

# ------------------------------------------------------------------------------
# 4. Incident Telemetry & Telegram Alerts (ops/incident.sh)
# ------------------------------------------------------------------------------
# Telegram Bot API token for dispatching critical service incident alerts
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Telegram numeric Chat ID of the operator authorized to receive incident alerts
TELEGRAM_CHAT_ID=987654321

# ------------------------------------------------------------------------------
# 5. LLM Gateway & Hermes Agent Execution (dispatcher/dispatcher.py)
# ------------------------------------------------------------------------------
# Optional: Hermes agent API base endpoint URL
OPENAI_API_BASE=http://127.0.0.1:20128/v1

# Optional: Alternative OpenAI-compatible base URL
OPENAI_BASE_URL=http://127.0.0.1:20128/v1

# Optional: URL of 9router proxy endpoint if proxying LLM requests
9ROUTER_URL=http://127.0.0.1:20128

# Optional: Maximum agent conversational turns / iteration ceiling (default: 30)
HERMES_MAX_ITERATIONS=30

# ------------------------------------------------------------------------------
# 6. Web Console Server (app.py)
# ------------------------------------------------------------------------------
# Listening port for FastAPI console server (default: 8082)
PORT=8082
